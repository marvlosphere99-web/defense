{
  "name": "packet-journey-visualizer",
  "version": "1.0.0",
  "description": "Real-time packet journey visualizer desktop app",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.packetjourney.visualizer",
    "productName": "Packet Journey Visualizer",
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "script.js",
      "backend.js",
      "supabaseClient.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
